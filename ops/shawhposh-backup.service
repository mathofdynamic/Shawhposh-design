[Unit]
Description=Shawhposh SQLite online backup
OnSuccess=shawhposh-replicate.service
[Service]
Type=oneshot
User=shawhposh
Group=shawhposh
WorkingDirectory=/opt/shawhposh/current
EnvironmentFile=/var/lib/shawhposh/.env
EnvironmentFile=/opt/shawhposh/current/release.env
Environment=BACKUP_DIRECTORY=/var/backups/shawhposh
ExecStart=/usr/bin/node /opt/shawhposh/current/server-dist/db/backup.js
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/shawhposh /var/backups/shawhposh
