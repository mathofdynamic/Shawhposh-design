[Unit]
Description=Shawhposh SQLite online backup
[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/shawhposh/current
EnvironmentFile=/var/lib/shawhposh/.env
Environment=BACKUP_DIRECTORY=/var/backups/shawhposh
ExecStart=/usr/bin/node /home/ubuntu/shawhposh/current/server-dist/db/backup.js
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shawhposh /var/backups/shawhposh
