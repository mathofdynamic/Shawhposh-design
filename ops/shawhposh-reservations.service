[Unit]
Description=Release expired Shawhposh inventory reservations
After=local-fs.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/shawhposh/current
EnvironmentFile=/var/lib/shawhposh/.env
ExecStart=/usr/bin/env node /home/ubuntu/shawhposh/current/server-dist/modules/orders/expire-reservations.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/shawhposh
