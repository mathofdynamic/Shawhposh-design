[Unit]
Description=Release expired Shawhposh inventory reservations
After=local-fs.target

[Service]
Type=oneshot
User=shawhposh
Group=shawhposh
WorkingDirectory=/home/ubuntu/shawhposh/current
EnvironmentFile=/var/lib/shawhposh/.env
ExecStart=/usr/bin/node /home/ubuntu/shawhposh/current/server-dist/modules/orders/expire-reservations.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/shawhposh
