{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test:invariants": "tsx src/admin/domain/verify-invariants.ts",
    "test:journeys": "tsx --test src/admin/domain/__tests__/journeys.test.ts",
    "test": "npm run test:invariants && npm run test:journeys && npm run test:ui",
    "lint": "tsc --noEmit",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "esbuild server/index.ts server/db/migrate.ts server/db/seed.ts server/modules/admin/create-owner.ts server/db/backup.ts --bundle --platform=node --packages=external --format=esm --outdir=server-dist --outbase=server",
    "server:start": "node server-dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:status": "tsx server/db/migrate.ts --status",
    "db:seed": "tsx server/db/seed.ts",
    "admin:create-owner": "tsx server/modules/admin/create-owner.ts",
    "test:backend": "tsx --test server/tests/*.test.ts",
    "test:ui": "tsx --test src/admin/domain/__tests__/pagination.test.tsx",
    "server:check": "tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.45.1",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
