DATABASE_PATH=./data/shawhposh.sqlite
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=3039
APP_VERSION=phase2
# Shipping methods and prices are configured by an owner in Admin > Settings > Shipping.
CHECKOUT_RESERVATION_MINUTES=20
# Server-only. No VITE secrets. Sessions use random hashed tokens, not a shared signing secret.
# OWNER_EMAIL and OWNER_NAME optional for bootstrap.
# OWNER_CREDENTIAL_FILE must be outside the repository for generated credentials.
PAYMENT_RECEIPT_DIR=/var/lib/shawhposh/uploads/payment-receipts
# Payment secrets are server-only. Never add a VITE_ prefix.
BALE_BOT_TOKEN=
BALE_BOT_USERNAME=
BALE_PAYMENT_PROVIDER_TOKEN=
# Generate a random value with at least 32 characters; never use the bot token here.
BALE_WEBHOOK_SECRET=
BALE_API_BASE=https://tapi.bale.ai
